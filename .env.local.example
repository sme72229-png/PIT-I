# Fontes Mobilidade B2B — copie este arquivo para .env.local e preencha
# com os valores do SEU projeto Supabase (Dashboard → Settings → API).

# URL do projeto Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Chave anônima (anon public) — tabelas abertas fazem SELECT e INSERT com ela
NEXT_PUBLIC_SUPABASE_ANON_KEY=
